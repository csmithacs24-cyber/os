#include<stdio.h>

int main()
{
    int n, bt[10], p[10], wt[10], tat[10], ct[10];
    int i, j, temp;
    float avgwt=0, avgtat=0;

    printf("Enter number of processes: ");
    scanf("%d",&n);

    printf("Enter Burst Time and Priority:\n");
    for(i=0;i<n;i++)
        scanf("%d%d",&bt[i],&p[i]);

    for(i=0;i<n-1;i++)
    {
        for(j=i+1;j<n;j++)
        {
            if(p[i]>p[j])
            {
                temp=p[i]; p[i]=p[j]; p[j]=temp;
                temp=bt[i]; bt[i]=bt[j]; bt[j]=temp;
            }
        }
    }

    ct[0]=bt[0];
    for(i=1;i<n;i++)
        ct[i]=ct[i-1]+bt[i];

    for(i=0;i<n;i++)
    {
        tat[i]=ct[i];
        wt[i]=tat[i]-bt[i];

        avgwt+=wt[i];
        avgtat+=tat[i];
    }

    printf("\nBT\tP\tCT\tTAT\tWT\n");
    for(i=0;i<n;i++)
        printf("%d\t%d\t%d\t%d\t%d\n",
               bt[i],p[i],ct[i],tat[i],wt[i]);

    printf("\nAverage WT = %.2f",avgwt/n);
    printf("\nAverage TAT = %.2f",avgtat/n);

    return 0;
}
